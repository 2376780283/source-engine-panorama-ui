<?xml version="1.0" encoding="utf-8"?>
<!-- SE port: smoke test for the ported game-client panel classes and (batch E) the UiToolkitAPI
     JavaScript component.  Loaded with:  +panorama_menu se_panels_test.xml
     Not part of the shipped content - it exists so the classes can be exercised without the pause
     menu / HUD layouts (which this port does not deploy yet). -->
<root>
	<!-- Panorama requires <scripts> before any child panel (layoutfile.cpp: "Scripts must be declared
	     first before any child panels") - putting it inside a panel makes the whole layout fail to load. -->
	<scripts>
		<include src="file://{resources}/scripts/se_popup_probe.js" />
	</scripts>

	<Panel style="width: 100%; height: 100%; background-color: #202020ff;">
		<Panel id="SeBlurSource" style="width: 400px; height: 200px; margin: 30px; background-color: #ff0000ff;" />
		<CSGOBlurTarget id="SeBlurTarget" blurrects="SeBlurSource" style="width: 100%; height: 100%;" />
		<CSGOBackbufferImagePanel style="width: 300px; height: 200px; margin-left: 560px; margin-top: 30px;" />
		<CustomLayoutPanel id="SeCustomLayout" style="width: 120px; height: 60px; margin: 30px; background-color: #00ff00ff;" />

		<!-- The popup / tooltip / context-menu hosts, in the same shape CS:GO uses: base_globalpopups.xml
		     is a window whose root is <CSGOGlobalPopups>, and that class loads globalpopups.xml, which
		     instantiates the three managers.  UiToolkitAPI resolves them through the per-window CUI_Root
		     (CUI_Root::GetRootForWindow), which is why one of these has to exist in the layout:
		     in the real main menu that root is <CSGOMainMenu> (CCSGO_MainMenu derives from CUI_Root). -->
		<CSGOGlobalPopups id="GlobalPopups" />
	</Panel>
</root>
