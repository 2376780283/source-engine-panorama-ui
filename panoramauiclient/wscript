#! /usr/bin/env python
# encoding: utf-8
# Phase 2: panoramauiclient.dll (ported from D:\CSGO2019\panoramauiclient).
#
# This is CS:GO's thin client-side proxy DLL: it exposes a single interface
# (IPanoramaUIClient, EXPOSE_SINGLE_INTERFACE_GLOBALVAR at the bottom of
# panoramauiclient.cpp) and forwards to the panorama UI engine created by the engine's
# IPanoramaUIEngine factory.  In CS:GO it also links the pre-built panorama_client lib.
#
# Source list mirrors panoramauiclient.vpc "Source Files".  Notes:
#   * thirdparty/JSON_parser/JSON_parser.c is listed by the vpc but does not exist in
#     either source tree - excluded until something actually needs it.
#   * pcre/pcrecpp and video are only listed as link libraries in the vpc; the port does
#     not need them yet (debuglayout.cpp is the only PCRE consumer and it is parked).
#
# The DLL links the three panorama static libs from this tree.

top = '.'
PROJECT_NAME = 'panoramauiclient'


def options(opt):
	return


def configure(conf):
	return


def build(bld):
	# 32-bit only: see the note in panorama/wscript (no x64 prebuilt V8 for Windows in this tree).
	if bld.env.DEST_CPU in ('x86_64', 'amd64'):
		from waflib import Logs
		Logs.warn('panoramauiclient: skipped in 64-bit builds (no x64 prebuilt V8)')
		return

	source = [
		'panoramauiclient.cpp',
		'../panorama_s1wrapper/utlstringbuilder.cpp',
		'../panorama_s1wrapper/wrap_misc.cpp',
		# SE port: CS:GO creates its main-menu background movie from the game-client panel class
		# (csgo_mainmenu.cpp::LoadBackgroundMovie); this is that code, exported for engine.dll.
		'se_background_movie.cpp',
		# SE port: the game-client panorama panel classes that CS:GO's layouts use.  They live under
		# panorama/seport/gameclient/ (mirroring CS:GO's game/client/... layout) but are compiled here,
		# because REGISTER_PANEL2D_FACTORY in a static library object is never pulled into the link.
		'../panorama/seport/gameclient/csgo_blurtarget.cpp',
		'../panorama/seport/gameclient/csgo_backbufferimage.cpp',
		# SE port: the batch-A "host layer" of CS:GO's game/client/panorama (see
		# docs/panorama_stage2_plan.md).  They are listed for the same reason as the panel classes
		# above: a REGISTER_PANEL2D/_FACTORY in a static library object is never pulled into the link.
		'../panorama/seport/gameclient/panorama/se_gameclient_globals.cpp',
		'../panorama/seport/gameclient/panorama/ui_symbols.cpp',
		'../panorama/seport/gameclient/panorama/ui_custom_layout.cpp',
		'../panorama/seport/gameclient/panorama/ui_js_panel.cpp',
		'../panorama/seport/gameclient/panorama/ui_root.cpp',
		# SE port: batch B (tooltip) - the framework-side manager + tooltip panel family, plus the two
		# CS:GO (cstrike15) skins the layouts actually name.
		'../panorama/seport/gameclient/panorama/ui_tooltip_manager.cpp',
		'../panorama/seport/gameclient/panorama/tooltips/ui_tooltip_base.cpp',
		'../panorama/seport/gameclient/panorama/tooltips/ui_tooltip_text.cpp',
		'../panorama/seport/gameclient/panorama/tooltips/ui_tooltip_title_text.cpp',
		'../panorama/seport/gameclient/panorama/tooltips/ui_tooltip_title_image_text.cpp',
		'../panorama/seport/gameclient/panorama/tooltips/ui_tooltip_custom_layout.cpp',
		'../panorama/seport/gameclient/cstrike15/panorama/csgo_tooltippanel.cpp',
		'../panorama/seport/gameclient/cstrike15/panorama/csgo_ui_tooltip_manager.cpp',
		# SE port: batch C (popup) - the framework-side manager + popup panel family, plus CS:GO's
		# (cstrike15) popup skins that the layouts name (#CSGOPopupManager / global popups).
		'../panorama/seport/gameclient/panorama/ui_popup_manager.cpp',
		'../panorama/seport/gameclient/panorama/ui_popup.cpp',
		'../panorama/seport/gameclient/panorama/popups/ui_popup_generic.cpp',
		'../panorama/seport/gameclient/panorama/popups/ui_popup_generic_text_entry.cpp',
		'../panorama/seport/gameclient/panorama/popups/ui_popup_custom_layout.cpp',
		'../panorama/seport/gameclient/cstrike15/panorama/csgo_popup_manager.cpp',
		'../panorama/seport/gameclient/cstrike15/panorama/csgo_globalpopups.cpp',
		# SE port: batch E (JS component framework) - CS:GO's cstrike15 uicomponents, which is what
		# publishes the "UiToolkitAPI" global to the panorama JavaScript (popups/tooltips/context menus/
		# deny-input + the JS callback plumbing).  See docs/panorama_stage2_plan.md.
		'se_uicomponents.cpp',
		'../panorama/seport/gameclient/cstrike15/uicomponents/uicomponent_common.cpp',
		'../panorama/seport/gameclient/cstrike15/uicomponents/uicomponent_uitoolkit.cpp',
		# ... and the two GameUI helpers the ported code needs (CS:GO: cstrike15/gameui/gameui_util.*)
		'../panorama/seport/gameclient/se_gameui_util.cpp',
		# ... plus the gcsdk JSON/XML string escapers that uicomponent_common.cpp declares as an extern
		# (gcsdk/webapi_response.cpp cannot be linked here - see the note in se_webapi_json.cpp).
		'../panorama/seport/gameclient/se_webapi_json.cpp',
		# SE port: batch D (context menu) - the manager the layouts name (#ContextMenuManager is in
		# mainmenu.xml) plus the context menu panel family.  csgo_globalpopups.cpp (batch C) already
		# includes panorama/ui_context_menu_manager.h, so the two batches are compiled together.
		'../panorama/seport/gameclient/panorama/ui_context_menu_manager.cpp',
		'../panorama/seport/gameclient/panorama/context_menus/ui_context_menu_base.cpp',
		'../panorama/seport/gameclient/panorama/context_menus/ui_context_menu_custom_layout.cpp',
		# '../thirdparty/JSON_parser/JSON_parser.c',   # not present in this tree
	]

	includes = [
		'.',
		'../panorama',              # panorama/uipanel.h, stdafx_client.h (CS:GO's private framework headers)
		# SE port: the game-client layer (game/client/panorama equivalents) is included so that the
		# ported sources keep CS:GO's own spelling, e.g. #include "panorama/ui_root.h".
		'../panorama/seport/gameclient',
		# ... and the cstrike15 half, so #include "panorama/csgo_tooltippanel.h" keeps CS:GO's spelling
		# (the compiler searches both, exactly like CS:GO's two include dirs game/client/panorama and
		# game/client/cstrike15).
		'../panorama/seport/gameclient/cstrike15',
		# SE port: batch E - the uicomponent framework includes its own headers by bare name
		# ("uicomponent_common.h", "uicomponent_uitoolkit.functions.inc"), the same way CS:GO resolves
		# them inside game/client/cstrike15/uicomponents.
		'../panorama/seport/gameclient/cstrike15/uicomponents',
		# ... and game/shared/bannedwords.h, which uicomponent_common.h includes by bare name.
		'../panorama/seport/gameclient/game/shared',
		'..',
		# The lightweight Source2 interfaces from panorama_s1wrapper must win over ../public
		# (same order as panorama/wscript): public/rendersystem/irenderdevice.h would otherwise
		# declare VertexBufferHandle_t as a pointer handle and clash with the int typedef in
		# public/materialsystem/imaterialsystem.h.
		'../panorama_s1wrapper',
		'../panorama_s1wrapper/tier1',
		'../panorama/steamextra/common',
		'../panorama/steamextra/public',
		'../public',
		'../public/tier0',
		'../public/tier1',
		'../public/tier2',
		'../public/vstdlib',
		'../public/panorama',
		'../public/steam',
		'../common',
		'../gcsdk/steamextra',
		'../thirdparty/protobuf-2.6.1/src',
		'../external/v8/include',
		'../external/v8',
		'../external',
	]

	defines = [
		# Match panoramauiclient.vpc
		'SOURCE2_PANORAMA',
		'SOURCE2_PANORAMA_FIXME',
		'PANORAMA_USE_S1WRAPPER',
		# public/interfaces/interfaces.h only exposes PANORAMAUI_CLIENT/ENGINE_INTERFACE_VERSION,
		# g_pPanoramaUIEngine ... inside #ifdef PANORAMA_ENABLE (CS:GO's VPC conditional).
		'PANORAMA_ENABLE',
		# See the long note in panorama/wscript: every panorama module of this port is built with
		# PANORAMA_EXPORTS so that the out-of-line UIEngine()/... from the framework lib are used.
		'PANORAMA_EXPORTS',
		# NOTE: PANORAMA_EXPORTS is deliberately NOT defined here.  panoramauiclient.vpc does not
		# define it either: in public/panorama/iuiengine.h the declarations of
		# g_pUIEngineSingleton / CreatePanoramaUIEngine() / ConnectPanoramaUIEngine() / ... are
		# inside #ifndef PANORAMA_EXPORTS (that define is for the panorama framework itself).
		'STEAM_API_NODLL',
		'_CLIENT',
		# SE port: match CS:GO's cstrike15 build configuration.  The ported game-client sources branch on
		# this (ui_root.cpp: CSTRIKE15 there are the CS:GO paths - colorblind-mode class, TrunkOnly,
		# FireGameEvent by event name - as opposed to the Dota paths).
		'CSTRIKE15',
		# SE-era adaption (SE tier0/platform.h already provides the construct helpers)
		'SE_PLATFORM_HAS_CONSTRUCT_HELPERS',
	]

	# The three panorama static libs plus the engine modules their code calls into.
	libs = [
		'panorama',
		'panorama_client',
		'panorama_s1wrapper',
		'tier0',
		'tier1',
		'tier2',
		'tier3',
		'mathlib',
		'vstdlib',
		'bitmap',
		'materialsystem',
		'vgui_controls',
		'vgui_surfacelib',
		# vtf: panorama_s1wrapper/wrap_texture.cpp creates textures through CreateVTFTexture()/
		# DestroyVTFTexture(), which Source Engine 2013 defines in its vtf module.
		'vtf',
		# stub_steam: the CCallback/CCallResult templates in public/steam/steam_api.h call the
		# extern "C" SteamAPI_Register{Callback,CallResult}()/Unregister... entry points, which this
		# tree provides through its stub steam_api implementation (stub_steam/wscript builds a shlib
		# whose target name is 'steam_api', matching how gameui/vtex/engine link it).
		'steam_api',
	]

	# External third-party static libs (vendored, not part of the waf project list).
	# NOTE: waf's MSVC link task ignores the `libpath` keyword and re-relativises relative stlib
	# paths against the top directory, so these are spelled out as absolute paths (waf appends
	# the .lib suffix itself).
	import os
	_topdir = os.path.dirname( bld.path.abspath() )
	stlibs = [
		os.path.join( _topdir, 'external', 'v8', 'lib', 'win', 'x86', 'v8_monolith' ),
		os.path.join( _topdir, 'external', 'v8', 'lib', 'win', 'x86', 'v8_libbase' ),
		os.path.join( _topdir, 'external', 'v8', 'lib', 'win', 'x86', 'v8_libplatform' ),
		os.path.join( _topdir, 'build', 'protobuf', 'libprotobuf' ),
	]

	if bld.env.DEST_OS == 'win32':
		# mfplat/mfreadwrite/mfuuid: Media Foundation, used by video/video_mf/mf_video_player.cpp
		# (the SE port's implementation of the libvideo player API that panorama calls for its
		# <Movie> panels - the CS:GO main menu background video).
		libs += ['USER32', 'GDI32', 'SHELL32', 'SHLWAPI', 'ADVAPI32', 'WS2_32', 'OLE32', 'WINMM', 'DBGHELP', 'USERENV',
			'mfplat', 'mfreadwrite', 'mfuuid']

	bld.shlib(
		source   = source,
		target   = PROJECT_NAME,
		name     = PROJECT_NAME,
		features = 'c cxx',
		includes = includes,
		defines  = defines,
		use      = libs,
		stlib    = stlibs,
		install_path = None,
		subsystem = bld.env.MSVC_SUBSYSTEM,
		idx      = bld.get_taskgen_count()
	)
